# Create an API key at https://aistudio.google.com/app/apikey
# Use either variable name. GEMINI_API_KEY is shown because it matches AI Studio.
GEMINI_API_KEY=replace_me
# GOOGLE_API_KEY=replace_me
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
# Older ADK releases use this equivalent variable.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ADK Web uses a live WebSocket session in every workshop checkpoint.
LIVE_MODEL=gemini-3.1-flash-live-preview

# Optional: set to 1 before the failure demo.
ROOM_TOOL_FAIL=0

# Optional: shorten this while rehearsing; keep 5 for the workshop latency demo.
ROOM_TOOL_DELAY_SECONDS=5
